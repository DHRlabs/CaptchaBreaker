# CaptchaBreaker configuration — copy to .env and fill in what you need.
#
# The LOCAL OCR backend needs NO configuration at all — it solves image/text/math
# CAPTCHAs offline and free. Only if you need reCAPTCHA/hCaptcha/Turnstile do you
# need a paid provider key (2Captcha / CapSolver / CapMonster / RuCaptcha).

# Provider (default capsolver). Options: capsolver | 2captcha | capmonster | rucaptcha
CAPTCHABREAKER_PROVIDER=capsolver

# Your provider API key (leave empty in dev; network solves are skipped).
CAPTCHABREAKER_API_KEY=

# Full host override (only if not using a default provider host).
# CAPTCHABREAKER_HOST=https://api.capsolver.com

# Seconds to keep polling the provider for a result.
CAPTCHABREAKER_TIMEOUT=120

# Port for the local HTTP server (used by agents).
CAPTCHABREAKER_PORT=8977

CAPTCHABREAKER_DEBUG=0
