# CaptchaBreaker configuration — copy to .env only if you need to customize.
#
# CaptchaBreaker runs locally by default. Image/text/math CAPTCHAs use the
# built-in OCR engine with no API key or internet. HumanPass can optionally use
# an explicitly enabled external vision backend for image-grid challenges.

# Port for the local HTTP server (used by agents).
CAPTCHABREAKER_PORT=8977
# Keep local launches loopback-only. Docker overrides this to 0.0.0.0 inside
# the container, while the compose port remains bound to the local host.
CAPTCHABREAKER_HOST=127.0.0.1
CAPTCHABREAKER_DEBUG=0

# Vision is off unless explicitly enabled, even when OPENAI_API_KEY is set.
# VISION_ENABLED=1
# VISION_API_KEY=...
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_MODEL=openai/gpt-4o
